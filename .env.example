NEXT_PUBLIC_APP_URL=http://localhost:3000

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

FLIGHT_API_KEY=your_licensed_flight_api_key
TRAIN_API_KEY=your_licensed_train_api_key
BUS_API_KEY=your_licensed_bus_api_key

# Optional live data gateway endpoints. Each endpoint must return source-native
# records containing exact station/airport codes, names, ISO departure/arrival
# times, fare when available, and provider booking URL. No schedule defaults are
# substituted when a field is missing.
SKYSCANNER_API_URL=https://your-authorized-flight-data-gateway.example
TRAINS_API_URL=https://your-authorized-rail-data-gateway.example
BUS_API_URL=https://your-authorized-bus-data-gateway.example

# Optional TripJack MCP adapter. Use the full HTTPS endpoint URLs supplied in
# your TripJack flight API collection; the API key must stay server-side.
TRIPJACK_API_KEY=
TRIPJACK_FLIGHT_SEARCH_URL=
TRIPJACK_BOOK_URL=
TRIPJACK_TICKET_INFO_URL=
# Keep false until booking has been UAT-tested and explicitly approved.
TRIPJACK_ENABLE_BOOKING=false
